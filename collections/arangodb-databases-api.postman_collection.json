            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"<string>\",\n  \"options\": {\n    \"replicationFactor\": \"<integer>\",\n    \"sharding\": \"\",\n    \"writeConcern\": \"<number>\"\n  },\n  \"users\": [\n    {\n      \"username\": \"<string>\",\n      \"active\": true,\n      \"extra\": \"<object>\",\n      \"passwd\": \"<string>\"\n    },\n    {\n      \"username\": \"<string>\",\n      \"active\": true,\n      \"extra\": \"<object>\",\n      \"passwd\": \"<string>\"\n    }\n  ]\n}",
