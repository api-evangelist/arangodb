          "name": "Create an access token",
          "request": {
            "name": "Create an access token",
            "description": {
              "content": "Create a new access token for the given user.\n\nThe response includes the actual access token string that you need to\nstore in a secure manner. It is only shown once.\n\nThe user account you authenticate with needs to have administrate access\nto the `_system` database if you want to create an access token for a\ndifferent user. You can always create an access token for yourself,\nregardless of database access levels.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "_api",
                "token",
                ":user"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "user",
                  "description": "(Required) The name of the user.\n"
