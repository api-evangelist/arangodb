{
  "opencollection": "1.0.0",
  "info": {
    "name": "ArangoDB Core Graphs API",
    "version": "3.12.10 (API v0)"
  },
  "items": [
    {
      "info": {
        "name": "Graphs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get inbound and outbound edges",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/_db/:database-name/_api/edges/:collection",
            "headers": [
              {
                "name": "x-arango-allow-dirty-read",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "database-name",
                "value": "_system",
                "type": "path",
                "description": "The name of the database.\n"
              },
              {
                "name": "collection",
                "value": "",
                "type": "path",
                "description": "The name of the edge collection you want to retrieve edges from.\n"
              },
              {
                "name": "vertex",
                "value": "",
                "type": "query",
                "description": "The document identifier of the start node.\n"
              },
              {
                "name": "direction",
                "value": "",
                "type": "query",
                "description": "- `\"in\"`: Return edges that reference the `vertex` in the `_to` attribute.\n- `\"out\"`: Return edges that reference the `vertex` in the `_from` attribute.\n- `\"any\"`: Return edges that reference the `vertex` in the `_from` or `_to` attribute.\n"
              }
            ]
          },
          "docs": "Returns an array of edges starting or ending in the node identified by\n`vertex`.\n"
        },
        {
          "info": {
            "name": "List all graphs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/_db/:database-name/_api/gharial",
            "params": [
              {
                "name": "database-name",
                "value": "_system",
                "type": "path",
                "description": "The name of the database.\n"
              }
            ]
          },
          "docs": "Lists all graphs stored in this database.\n"
        },
        {
          "info": {
            "name": "Create a graph",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/_db/:database-name/_api/gharial",
            "params": [
              {
                "name": "database-name",
                "value": "_system",
                "type": "path",
                "description": "The name of the database.\n"
              },
              {
                "name": "waitForSync",
                "value": "",
                "type": "query",
                "description": "Define if the request should wait until everything is synced to disk.\nChanges the success HTTP response status code.\n"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "The creation of a graph requires the name of the graph and a\ndefinition of its edges.\n"
        },
        {
          "info": {
            "name": "Get a graph",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/_db/:database-name/_api/gharial/:graph",
            "params": [
              {
                "name": "database-name",
                "value": "_system",
                "type": "path",
                "description": "The name of the database.\n"
              },
              {
                "name": "graph",
                "value": "",
                "type": "path",
                "description": "The name of the graph.\n"
              }
            ]
          },
          "docs": "Selects information for a given graph.\nReturns the edge definitions as well as the orphan collections,\nor returns an error if the graph does not exist.\n"
        },
        {
          "info": {
            "name": "Drop a graph",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/_db/:database-name/_api/gharial/:graph",
            "params": [
              {
                "name": "database-name",
                "value": "_system",
                "type": "path",
                "description": "The name of the database.\n"
              },
              {
                "name": "graph",
                "value": "",
                "type": "path",
                "description": "The name of the graph.\n"
              },
              {
                "name": "dropCollections",
                "value": "",
                "type": "query",
                "description": "Drop the collections of this graph as well. Collections are only\ndropped if they are not used in other graphs.\n"
              }
            ]
          },
          "docs": "Drops an existing graph object by name.\nOptionally all collections not used by other graphs\ncan be dropped as well.\n"
        },
        {
          "info": {
            "name": "List edge collections",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/_db/:database-name/_api/gharial/:graph/edge",
            "params": [
