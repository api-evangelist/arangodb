        {
          "info": {
            "name": "List all Views",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/_db/:database-name/_api/view",
            "params": [
              {
                "name": "database-name",
                "value": "_system",
                "type": "path",
                "description": "The name of the database.\n"
              }
            ]
          },
          "docs": "Returns an object containing a listing of all Views in the current database,\nregardless of their type.\n"
        },
        {
