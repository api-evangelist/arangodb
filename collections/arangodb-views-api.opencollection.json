            "url": "{{baseUrl}}/_db/:database-name/_api/view",
            "params": [
              {
                "name": "database-name",
                "value": "_system",
                "type": "path",
                "description": "The name of the database.\n"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new View with a given name and properties if it does not\nalready exist.\n"
        },
